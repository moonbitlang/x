}

import {
  "moonbitlang/x/encoding",
  "moonbitlang/core/env",
  "moonbitlang/core/test",
} for "test"

options(
  "native-stub": [ "fs_native.c", "file_native.c" ],
  targets: {
    "file.mbt": [ "native", "llvm", "wasm", "js" ],
    "file_native.mbt": [ "native", "llvm" ],
    "file_wasm.mbt": [ "wasm" ],
    "file_js.mbt": [ "js" ],
    "file_test.mbt": [ "native", "llvm", "wasm", "js" ],
    "file_js_wbtest.mbt": [ "js" ],
    "fs_js.mbt": [ "js" ],
    "fs_native.mbt": [ "native", "llvm" ],
    "fs_wasm.mbt": [ "wasm", "wasm-gc" ],
  },
)
