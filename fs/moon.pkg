#cfg(target="wasm")
import {
  "moonbitlang/x/internal/wasm_file",
}

import {
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/x/encoding",
  "moonbitlang/core/env",
  "moonbitlang/core/test",
} for "test"

options(
  "native-stub": [ "fs_native.c", "file_native.c" ],
  targets: {
    "fs_js.mbt": [ "js" ],
    "fs_native.mbt": [ "native", "llvm" ],
    "fs_wasm.mbt": [ "wasm", "wasm-gc" ],
  },
)
